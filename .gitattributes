# LF in the repo and on checkout.
# Ava ships Linux, macOS, and Windows binaries; rustfmt, installers, and CI assume LF.
* text=auto eol=lf

# Source, config, docs
*.rs            text diff=rust
*.toml          text
*.md            text diff=markdown
*.json          text
*.jsonc         text
*.yml           text
*.yaml          text
*.lock          text
*.txt           text
*.svg           text

# Unix installers (must stay LF on Windows checkouts)
*.sh            text eol=lf
*.bash          text eol=lf

# Windows installers
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# Package artifacts, native libs, images
*.tar           binary
*.gz            binary
*.tgz           binary
*.zip           binary
*.exe           binary
*.dll           binary
*.so            binary
*.dylib         binary
*.wasm          binary
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.webp          binary
*.woff          binary
*.woff2         binary

# Generated — keep in git, hide from GitHub language stats
Cargo.lock      linguist-generated=true
